#!/bin/sh
# Checks this repo's commit message format (see README.md / CLAUDE.md):
#
#   MM/DD/YY: <description>       first line, at most 72 characters
#                                 optional: a blank line, then only
#   Key: value                    Key: value lines (e.g. Co-Authored-By)
#
# The date is checked as a format only (month 01-12, day 01-31), not against
# today's date. fixup!/squash!/amend! commits pass through untouched, since
# `git rebase --autosquash` folds them into the commit they fix.

msg_file=$1
max_len=72

# git runs this hook before it cleans up the message, so strip the
# `git commit -v` diff and the comment lines the same way git will.
msg=$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' "$msg_file" | git stripspace --strip-comments)

# An empty message is rejected by git itself, with its usual error.
[ -z "$msg" ] && exit 0

subject=$(printf '%s\n' "$msg" | sed -n '1p')
rest=$(printf '%s\n' "$msg" | sed '1d')

fail() {
  {
    printf 'commit-msg: %s\n\n' "$1"
    printf '  Format:   MM/DD/YY: description   (first line, max %s chars)\n' "$max_len"
    printf '  Optional: a blank line, then only "Key: value" lines\n'
    printf '  Example:  %s: rate-limiter: add token bucket\n\n' "$(date +%m/%d/%y)"
    printf '  Your message:\n'
    printf '%s\n' "$msg" | sed 's/^/    | /'
    printf '\n'
  } >&2
  exit 1
}

case $subject in
  'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(0[1-9]|1[0-2])/(0[1-9]|[12][0-9]|3[01])/[0-9]{2}: [^[:space:]]'; then
  if printf '%s\n' "$subject" | grep -Eq '^[0-9]{2}/[0-9]{2}/[0-9]{2}:?$'; then
    fail "the description after the date is empty"
  fi
  fail "the first line must start with a valid MM/DD/YY date, a colon and a space"
fi

len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt "$max_len" ]; then
  fail "the first line is $len characters; the limit is $max_len"
fi

[ -z "$rest" ] && exit 0

if [ -n "$(printf '%s\n' "$rest" | sed -n '1p')" ]; then
  fail "put a blank line between the first line and any Key: value lines"
fi

trailers=$(printf '%s\n' "$rest" | sed '1d')
if printf '%s\n' "$trailers" | grep -q '^$'; then
  fail "keep the Key: value lines in one block, with no blank lines between them"
fi

# Allowed after the blank line: Key: value lines, plus the line(s) that
# `git revert` writes ("This reverts commit <sha>." / "..., reversing
# changes made to <sha>.").
bad=$(printf '%s\n' "$trailers" | grep -Ev \
  -e '^[A-Za-z][A-Za-z0-9-]*: [^[:space:]]' \
  -e '^This reverts commit [0-9a-f]{7,64}(\.|, reversing)$' \
  -e '^changes made to [0-9a-f]{7,64}\.$' | sed -n '1p')
if [ -n "$bad" ]; then
  fail "only Key: value lines may follow the first line (found: \"$bad\")"
fi

exit 0
