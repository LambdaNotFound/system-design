#!/bin/sh
# Puts today's date in front of the commit message when it's missing, so
#   git commit -m "rate-limiter: add token bucket"
# is committed as "11/08/26: rate-limiter: add token bucket".
# The commit-msg hook does the actual format check.
#
# Arguments from git: $1 = message file, $2 = message source (message,
# template, merge, squash, commit or empty), $3 = commit SHA (for commit).

msg_file=$1
source=$2

# --amend, -c, -C: the commit already has its message; leave it alone.
[ "$source" = commit ] && exit 0

today=$(date +%m/%d/%y)
scissors='^# -\{24\} >8 -\{24\}$'   # `git commit -v`: the diff below it isn't message

# The first line that isn't a comment or blank, above the scissors line.
first=$(sed -e "/$scissors/,\$d" "$msg_file" | grep -v '^#' | grep -v '^[[:space:]]*$' | sed -n '1p')

case $first in
  # These must stay at the start of the line for `git rebase --autosquash`.
  'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

# Already starts with something date-like: let commit-msg judge it.
if printf '%s\n' "$first" | grep -Eq '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4}'; then
  exit 0
fi

tmp="$msg_file.tmp.$$"
if [ -z "$first" ]; then
  # Empty message, editor about to open: start line 1 with the date.
  { printf '%s: \n' "$today"; cat "$msg_file"; } > "$tmp"
else
  awk -v d="$today" -v src="$source" -v q="'" '
    /^# -+ >8 -+$/ { cut = 1 }
    !done && !cut && $0 !~ /^#/ && $0 !~ /^[[:space:]]*$/ {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      # `git pull` merges say "Merge branch 'main' of <url> [into main]";
      # drop " of <url>" so the first line stays under the length limit.
      if (src == "merge" && match(line, q " of [^ ]+"))
        line = substr(line, 1, RSTART) substr(line, RSTART + RLENGTH)
      print d ": " line
      done = 1
      next
    }
    { print }
  ' "$msg_file" > "$tmp"
fi
mv "$tmp" "$msg_file"
