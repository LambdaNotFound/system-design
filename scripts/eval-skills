#!/usr/bin/env python3
"""Run the eval cases for this repo's skills with `claude plugin eval`.

    scripts/eval-skills                     every target, quick
    scripts/eval-skills scope-problem       one skill's cases
    scripts/eval-skills routing             the which-skill-fires cases
    scripts/eval-skills scope-problem --full
    scripts/eval-skills --case 'resumes-*' --model sonnet --max-cost 3

Quick (the default) runs each case once with no baseline. --full runs each case
three times, plus a baseline without the skill. These are real, billed model
runs on your account. The lint (scripts/check-skills) runs first, for free.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILLS = ROOT / ".claude" / "skills"
ROUTING = ROOT / "evals" / "routing"
MIN_GIT = (2, 31)   # the runner needs it to switch off the repo's git hooks during a run


def targets():
    """Name -> folder for everything that has eval cases."""
    found = {}
    for skill_dir in sorted(SKILLS.iterdir()):
        if (skill_dir / "SKILL.md").exists() and any((skill_dir / "evals").glob("*/prompt.md")):
            found[skill_dir.name] = skill_dir
    if any((ROUTING / "evals").glob("*/prompt.md")):
        found["routing"] = ROUTING
    return found


def git_version(git):
    try:
        out = subprocess.run([git, "--version"], stdout=subprocess.PIPE,
                             universal_newlines=True).stdout
    except OSError:
        return None
    match = re.search(r"(\d+)\.(\d+)", out)
    return (int(match.group(1)), int(match.group(2))) if match else None


def env_with_new_enough_git():
    """The runner refuses git older than 2.31. If the one on PATH is older, put a newer one first."""
    env = dict(os.environ)
    first = shutil.which("git")
    if first and (git_version(first) or (0, 0)) >= MIN_GIT:
        return env
    for git in ("/usr/bin/git", "/opt/homebrew/bin/git", "/usr/local/bin/git"):
        if os.path.exists(git) and (git_version(git) or (0, 0)) >= MIN_GIT:
            env["PATH"] = os.path.dirname(git) + os.pathsep + env.get("PATH", "")
            print(f"eval-skills: using {git} (the git first on PATH is older than "
                  f"{MIN_GIT[0]}.{MIN_GIT[1]})")
            return env
    sys.exit(f"eval-skills: no git {MIN_GIT[0]}.{MIN_GIT[1]} or newer found; the eval runner needs one")


def default_model():
    """The runner does not read your Claude Code settings, so pass your default model explicitly."""
    if os.environ.get("EVAL_MODEL"):
        return os.environ["EVAL_MODEL"]
    try:
        with open(os.path.expanduser("~/.claude/settings.json"), encoding="utf-8") as handle:
            return json.load(handle).get("model")
    except (OSError, ValueError):
        return None


def summarize(name, result, mode, model):
    """Print one line per case and return True when every case passed."""
    print(f"\n{name}  ({mode}, model: {model or 'runner default'})")
    cases = result.get("cases", [])
    all_passed = bool(cases)
    for case in cases:
        runs = case.get("arms", {}).get("with", [])
        passed_runs = sum(1 for run in runs if run.get("passed"))
        ok = bool(runs) and passed_runs == len(runs)
        all_passed = all_passed and ok
        graders = runs[0].get("graders", []) if runs else []
        detail = f"{sum(1 for g in graders if g.get('passed'))}/{len(graders)} graders"
        if len(runs) > 1:
            detail = f"{passed_runs}/{len(runs)} runs"
        print(f"  {'PASS' if ok else 'FAIL'}  {case['name']:<42} {detail}")
        for number, run in enumerate(runs, 1):
            label = f"run {number}: " if len(runs) > 1 else ""
            if run.get("error"):
                print(f"          {label}error: {run['error']}")
            for grader in run.get("graders", []):
                if not grader.get("passed"):
                    print(f"          {label}failed {grader['name']}: {grader.get('explanation', '')}")
    if not cases:
        print("  no cases ran")
    print(f"  cost ${result.get('costUsd', 0):.2f}, {result.get('durationSeconds', 0)}s")
    return all_passed


def main():
    available = targets()
    parser = argparse.ArgumentParser(description="Run this repo's skill evals (billed model runs).")
    parser.add_argument("target", nargs="*", help=f"one of: {', '.join(available) or 'none yet'}")
    parser.add_argument("--full", action="store_true",
                        help="three runs per case plus a baseline without the skill")
    parser.add_argument("--model", help="model to run on (default: EVAL_MODEL, else your Claude Code default)")
    parser.add_argument("--case", help="only cases whose name matches this glob")
    parser.add_argument("--max-cost", type=float, metavar="USD", help="hard cost ceiling per target")
    parser.add_argument("-j", "--concurrency", type=int, default=1, help="runs at once, 1 to 8")
    parser.add_argument("--skip-lint", action="store_true")
    args = parser.parse_args()

    unknown = [name for name in args.target if name not in available]
    if unknown:
        sys.exit(f"eval-skills: nothing to run for: {', '.join(unknown)} "
                 f"(have: {', '.join(available) or 'none'})")
    if not args.skip_lint:
        if subprocess.run([sys.executable, str(ROOT / "scripts" / "check-skills")]).returncode != 0:
            sys.exit("eval-skills: fix the lint errors first, or pass --skip-lint")

    env = env_with_new_enough_git()
    model = args.model or default_model()
    mode = "full" if args.full else "quick"
    all_passed = True
    for name in args.target or list(available):
        with tempfile.TemporaryDirectory() as scratch:
            json_path = os.path.join(scratch, "result.json")
            command = ["claude", "plugin", "eval", str(available[name]),
                       "--scaffold",        # cases copy their fixture files in
                       "--trust-plugin",    # these are this repo's own skills and cases
                       "--no-publish",      # keep the HTML report on this machine
                       "--allow-tools", "Write", "Edit", "Bash",
                       "--concurrency", str(args.concurrency),
                       "--json", json_path]
            command += ["--runs", "3", "--ablation", "with-without"] if args.full \
                else ["--runs", "1", "--ablation", "none"]
            if model:
                command += ["--model", model]
            if args.case:
                command += ["--case", args.case]
            if args.max_cost is not None:
                command += ["--max-cost-usd", str(args.max_cost)]
            subprocess.run(command, cwd=str(ROOT), env=env)
            try:
                with open(json_path, encoding="utf-8") as handle:
                    result = json.load(handle)
            except (OSError, ValueError):
                print(f"\n{name}: the runner wrote no result")
                all_passed = False
                continue
            all_passed = summarize(name, result, mode, model) and all_passed
    sys.exit(0 if all_passed else 1)


if __name__ == "__main__":
    main()
